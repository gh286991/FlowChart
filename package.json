{
  "name": "flowchart",
  "version": "3.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "type-check": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "wrangler d1 migrations apply flowchart-db --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply flowchart-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flowchart-db --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.3",
    "@opennextjs/cloudflare": "^1.6.5",
    "@prisma/client": "^6.16.0",
    "@xyflow/react": "^12.8.4",
    "bcryptjs": "^3.0.2",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.0",
    "sass": "^1.89.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "wrangler": "^4.105.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
