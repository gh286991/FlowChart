{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowchart-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "MindMapMCP" },
      { "name": "MAP_STORE", "class_name": "MapStore" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MindMapMCP", "MapStore"]
    }
  ],
  "observability": { "enabled": true }
}
